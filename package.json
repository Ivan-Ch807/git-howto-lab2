{
  "name": "git-howto-lab2",
  "version": "0.4.0",
  "description": "Lab 2: package.json, dependencies, SemVer, TypeScript, and Git hooks",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "prepare": "husky"
  },
  "keywords": [
    "typescript",
    "semver",
    "husky",
    "eslint"
  ],
  "homepage": "https://github.com/Ivan-Ch807/git-howto-lab2#readme",
  "bugs": {
    "url": "https://github.com/Ivan-Ch807/git-howto-lab2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivan-Ch807/git-howto-lab2.git"
  },
  "license": "MIT",
  "author": "Ivan Chernenko",
  "dependencies": {
    "dotenv": "^18.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "commitlint": "^21.2.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
